# Generated Xcode project (we use XcodeGen — never commit the .xcodeproj)
*.xcodeproj/
*.xcworkspace/

# Xcode build output
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS metadata
.DS_Store

# CI artefacts
captures/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Codemagic local cache
.codemagic_cache/

# Secrets — anything ending in .secret or under secrets/
*.secret
secrets/

# Android upload keystore + passwords — MUST NEVER enter git history.
# Losing these credentials means losing the ability to push updates to the
# Play Store listing forever (Play App Signing only mitigates this if you
# opted in BEFORE losing the upload key). The .b64 export and PASSWORDS.txt
# live in this folder too.
android-keystore/

# IDE
.vscode/launch.json
.idea/

# Claude Code internal
.claude/

# Node (in case of tooling)
node_modules/

# Test outputs
*.xcresult
TestResults/

# Snapshot screenshots committed to repo go in docs/snapshots/, but local CI runs go to:
SnapshotArtifacts/

# Info.plist is generated by XcodeGen from project.yml on each CI run (info: block)
ios/LoverApp/Info.plist
ios/LoverAppTests/Info.plist
ios/LoverAppUITests/Info.plist
