<?xml version="1.0" encoding="UTF-8"?>
<!--
    Hardcoded Info.plist for the LoverApp target.
    Values mirror project.yml settings — keep them in sync if you change one:
        CFBundleIdentifier          ↔ PRODUCT_BUNDLE_IDENTIFIER
        CFBundleExecutable          ↔ PRODUCT_NAME (= "Lover")
        CFBundleName                ↔ PRODUCT_NAME
        CFBundleShortVersionString  ↔ MARKETING_VERSION
        CFBundleVersion             ↔ CURRENT_PROJECT_VERSION
    No $(VAR) substitutions — Xcode 26 + XcodeGen pipeline doesn't reliably expand them.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh-Hant</string>
    <key>CFBundleDisplayName</key>
    <string>Lover</string>
    <key>CFBundleExecutable</key>
    <string>Lover</string>
    <key>CFBundleIdentifier</key>
    <string>app.lover.LoverApp</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Lover</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh-Hant</string>
        <string>en</string>
        <string>ja</string>
    </array>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>NSCameraUsageDescription</key>
    <string>影相同對方分享</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>錄製語音訊息畀對方</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>揀相片同對方分享</string>
</dict>
</plist>
