<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Chat media -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Photo/video access uses the Android Photo Picker
         (ActivityResultContracts.PickVisualMedia), which needs NO runtime
         media permission, so READ_MEDIA_IMAGES is intentionally NOT declared
         (declaring it triggers Play's Photo & Video Permissions policy review
         for no benefit). READ_EXTERNAL_STORAGE is kept only for API ≤32 legacy
         pickers and is capped with maxSdkVersion so it is never requested on
         devices that have the granular media model. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".LoverApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoverApp"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LoverApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase B Round 2 — Firebase Cloud Messaging. The service handles
             token rotation (onNewToken) and foreground / data-only push
             delivery (onMessageReceived). Notification-style pushes received
             while the app is backgrounded are auto-handled by the FCM SDK
             into the `messages` channel (created in PushRepository). -->
        <service
            android:name="michel.kit.us.service.LoverFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default FCM notification channel id — used by FCM SDK when a
             notification-style push arrives in background. Must match
             PushRepository.MESSAGES_CHANNEL_ID. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />

        <!-- FileProvider for ActivityResultContracts.TakePicture — the
             system camera needs a content:// URI it can write the captured
             JPEG into. Authority matches what PhotoPicker builds. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
